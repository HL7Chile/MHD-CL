    "https://profiles.ihe.net/ITI/MHD/CapabilityStatement/IHE.MHD.DocumentSource",
    "https://profiles.ihe.net/ITI/MHD/CapabilityStatement/IHE.MHD.DocumentConsumer"
  ],
  "implementationGuide": [
    "https://hl7chile.cl/fhir/ig/mhd/ImplementationGuide/hl7.fhir.cl.mhdig"
  ],
  "rest": [
    {
      "security": {
        "description": "Las comunicaciones deben realizarse mediante HTTPS y utilizar\nlos mecanismos de autenticación, autorización, control de acceso,\nauditoría y trazabilidad definidos para la infraestructura local."
      },
      "interaction": [
        {
          "code": "transaction",
          "documentation": "ITI-65 Provide Document Bundle.\n\nEl cliente SHALL poder generar y enviar un Bundle transaction\nconforme al perfil BundleMhd definido por esta guía:\n\nhttps://hl7chile.cl/fhir/ig/mhd/StructureDefinition/BundleMhd"
        },
        {
          "code": "search-system",
          "documentation": "El cliente puede realizar búsquedas a nivel de sistema conforme\na las capacidades definidas para el Document Consumer de IHE MHD."
        }
      ],
